      "minCases": 1
    },
    {
      "id": "STD-FE-PAGINATION",
      "title": "分页或加载更多",
      "category": "pagination",
      "priority": "should",
      "dimensionHint": "boundary",
      "testPoints": ["翻页或加载更多可观察", "数据不足可 blocked 并写原因"],
      "minCases": 0
