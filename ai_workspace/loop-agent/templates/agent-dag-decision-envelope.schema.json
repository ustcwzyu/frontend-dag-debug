{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-agent.local/schemas/agent-dag-decision-envelope.schema.json",
  "title": "Agent DAG Decision Envelope",
  "description": "Structured output contract for advisory Agent DAG AI Secretary / Decision Gate nodes. M1 treats this as a documentation contract; M3 runtime parser extracts a ```DECISION_ENVELOPE_JSON fenced block and validates with zod plus semantic cross-field checks (recommendedOption must match options[].id; auto-approve must not set requiresHuman=true).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateType",
    "decisionScope",
    "decision",
    "confidence",
    "riskLevel",
    "requiresHuman",
    "nextAction",
    "policyVersion",
    "policyChecks",
    "rationale",
    "evidence",
    "blockingFindings",
    "requiredRevisions",
    "riskFlags",
    "humanEscalation",
    "audit"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "gateType": {
      "type": "string",
      "enum": ["plan-gate", "side-effect-gate", "acceptance-gate", "closeout-gate"]
    },
    "decisionScope": {
      "type": "string",
      "enum": ["node", "rank", "dag-run", "task", "repo"]
    },
    "decision": {
      "type": "string",
      "enum": [
        "auto-approve",
        "approve-with-constraints",
        "request-revision",
        "run-more-verification",
        "split-followup",
        "reject",
        "escalate-to-human",
        "pause-wait-external"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "requiresHuman": {
      "type": "boolean"
    },
    "nextAction": {
      "type": "string",
      "enum": [
        "continue",
        "rerun-implement",
        "rerun-verify",
        "run-targeted-check",
        "split-followup",
        "pause-and-ask",
        "abort"
      ]
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "policyChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mustEscalateFlags", "evidenceComplete", "allowedAutoApprove"],
      "properties": {
        "mustEscalateFlags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceComplete": {
          "type": "boolean"
        },
        "allowedAutoApprove": {
          "type": "boolean"
        }
      }
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "status", "summary"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["verified", "partial", "self-reported", "conflicting", "missing"]
          },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockingFindings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredRevisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "riskFlags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "humanEscalation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "recommendedOption", "options"],
          "properties": {
            "question": { "type": "string", "minLength": 1 },
            "recommendedOption": { "type": "string", "minLength": 1 },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "risk", "reason"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "risk": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runId", "nodeId", "model"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "sourceHash": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "requiresHuman": { "const": true } },
        "required": ["requiresHuman"]
      },
      "then": {
        "properties": {
          "humanEscalation": { "type": "object" },
          "nextAction": { "const": "pause-and-ask" }
        },
        "required": ["humanEscalation"]
      }
    },
    {
      "if": {
        "properties": { "requiresHuman": { "const": false } },
        "required": ["requiresHuman"]
      },
      "then": {
        "properties": {
          "humanEscalation": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": { "enum": ["escalate-to-human", "pause-wait-external"] }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "requiresHuman": { "const": true }
        }
      }
    }
  ]
}
