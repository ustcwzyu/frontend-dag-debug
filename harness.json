{
  "$schema": "./ai_workspace/loop-agent/templates/harness.schema.json",
  "version": 1,
  "project": "frontend-dag-debug",
  "adapter": "loop-agent",
  "governanceRoot": "ai_workspace/loop-agent",
  "features": {},
  "workflowPolicy": {
    "defaultImplementationWorkflow": "agent-dag",
    "dag": {
      "defaultEntry": "task advance",
      "outputLanguage": "zh-CN",
      "profileRouting": {
        "minimal": "standard-dag",
        "standard": "standard-dag",
        "reviewed": "review-gated-dag",
        "supervised": "supervised-implementation"
      }
    },
    "humanGatePolicy": {
      "defaultMode": "record-only",
      "pauseOn": [
        "requirement-ambiguity",
        "architecture-or-public-contract-risk",
        "credential-cost-or-deployment-risk",
        "repeated-gate-failure",
        "high-or-critical-decision-risk"
      ]
    }
  },
  "entrypoints": {
    "readme": "README.md",
    "agents": "AGENTS.md",
    "governanceIndex": "ai_workspace/loop-agent/README.md",
    "principles": "ai_workspace/loop-agent/development-principles.md",
    "workflow": "ai_workspace/loop-agent/feature-workflow.md",
    "verificationMatrix": "ai_workspace/loop-agent/verification-matrix.md",
    "loopAgentHarness": "ai_workspace/loop-agent/loop-agent-harness.md"
  },
  "artifacts": {
    "templatesDir": "ai_workspace/loop-agent/templates",
    "execPlansDir": "ai_workspace/loop-agent/exec-plans",
    "progressDir": "ai_workspace/loop-agent/progress",
    "reportsDir": "ai_workspace/loop-agent/reports",
    "decisionsDir": "ai_workspace/loop-agent/decisions",
    "taskPoolDir": ".harness/task-pool"
  },
  "scripts": {
    "checkEngineeringStructure": "scripts/check-engineering-structure.sh",
    "checkDocIndex": "scripts/check-doc-index.sh",
    "checkDocLinks": "scripts/check-doc-links.sh",
    "checkActivePlanStatus": "scripts/check-active-plan-status.sh",
    "checkExecPlanIndexSync": "scripts/check-exec-plan-index-sync.sh",
    "checkHarnessRuntimeClean": "scripts/check-harness-runtime-clean.sh",
    "checkArchitectureBoundaries": "scripts/check-architecture-boundaries.sh",
    "checkSkillEntry": "scripts/check-skill-entry.sh",
    "checkRepo": "scripts/check-repo.sh",
    "ciGovernance": "scripts/ci-governance.sh",
    "ciTests": "scripts/ci-tests.sh",
    "ci": "scripts/ci.sh",
    "quickVerify": "bash scripts/check-repo.sh",
    "standardVerify": "bash scripts/ci-governance.sh",
    "fullVerify": "bash scripts/ci.sh"
  },
  "executors": {
    "pi": {
      "description": "Pi planning, review, diagnosis, and bounded writing when DAG toolProfile=write",
      "LOW": "deepseek/deepseek-v4-flash",
      "MED": "deepseek/deepseek-v4-flash",
      "HIGH": "deepseek/deepseek-v4-flash"
    }
  }
}
